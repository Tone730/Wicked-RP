{
  "name": "wicked-rp",
  "productName": "Wicked RP",
  "version": "2.3.0",
  "description": "Wicked RP — customizable Discord Rich Presence manager. Real-time activity settings, multiple server profiles, startup + tray, built-in media manager, themes, presets, i18n translations, import/export, Discord Developer Portal redirect, activity types, auto-apply, getting started wizard, and more. No Discord Developer Portal required for basic text presence.",
  "main": "main.js",
  "author": "Wicked Development <wick777@engineer.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tone730/Wicked-RP.git"
  },
  "bugs": {
    "url": "https://github.com/Tone730/Wicked-RP/issues"
  },
  "homepage": "https://github.com/Tone730/Wicked-RP#readme",
  "keywords": [
    "discord",
    "discord-rpc",
    "rich-presence",
    "activity",
    "presence",
    "windows",
    "tray",
    "startup",
    "media-manager",
    "themes"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder -w"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-store": "^8.1.0",
    "electron-log": "^5.2.0",
    "chokidar": "^3.6.0"
  },
  "build": {
    "appId": "com.wicked.rp",
    "productName": "Wicked RP",
    "copyright": "Copyright © 2026 Wicked Development",
    "directories": {
      "output": "release",
      "app": "."
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "style.css",
      "assets/**",
      "media/**",
      "node_modules/**"
    ],
    "extraMetadata": {},
    "extraResources": [
      {
        "from": "media",
        "to": "media",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "Wicked Development"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
